drop procedure if exists check_bronze;

delimiter //

create procedure check_bronze()
begin
select 'loading bronze layer - crm customer data' as message;
select count(*) as total_records from bronze_crm_cust_info;

select 'loading bronze layer - product data' as message;
select count(*) as total_records from bronze_prd_info;

select 'loading bronze layer - sales data' as message;
select count(*) as total_records from bronze_sales_details;

select 'loading bronze layer - erp customer data' as message;
select count(*) as total_records from bronze_custaz12;

select 'loading bronze layer - location data' as message;
select count(*) as total_records from bronze_loc_a101;

select 'loading bronze layer - category data' as message;
select count(*) as total_records from bronze_px_cat_g1v2;

select 'bronze layer validation completed' as message;
end //

delimiter ;

call check_bronze();

